{
  "info": {
    "name": "authcore-webpanel",
    "description": "AuthCore web panel API requests. Set the authcore_token variable (panel token from session.web-panel.token in settings.conf).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Overview",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{authcore_token}}"
          }
        ],
        "url": {
          "raw": "{{authcore_base}}/api/overview",
          "host": [
            "{{authcore_base}}"
          ],
          "path": [
            "api",
            "overview"
          ]
        },
        "description": "GET /api/overview - server version, registered/online/inLobby/locked/premium counts, TPS, database dialect and Redis status."
      },
      "response": []
    },
    {
      "name": "List Players",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{authcore_token}}"
          }
        ],
        "url": {
          "raw": "{{authcore_base}}/api/players",
          "host": [
            "{{authcore_base}}"
          ],
          "path": [
            "api",
            "players"
          ]
        },
        "description": "GET /api/players - array of players (username, uuid, premium, registered, online, inLobby, locked, risk, ip, country) plus count."
      },
      "response": []
    },
    {
      "name": "Login History",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{authcore_token}}"
          }
        ],
        "url": {
          "raw": "{{authcore_base}}/api/history?uuid=069a79f4-44e9-4726-a5be-fca90e38aaf5",
          "host": [
            "{{authcore_base}}"
          ],
          "path": [
            "api",
            "history"
          ],
          "query": [
            {
              "key": "uuid",
              "value": "069a79f4-44e9-4726-a5be-fca90e38aaf5",
              "description": "Player UUID to fetch login history for (last 20 entries)"
            }
          ]
        },
        "description": "GET /api/history?uuid=<uuid> - login history array of strings for the given player."
      },
      "response": []
    },
    {
      "name": "Action Kick",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{authcore_token}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"action\": \"kick\",\n  \"uuid\": \"069a79f4-44e9-4726-a5be-fca90e38aaf5\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{authcore_base}}/api/action",
          "host": [
            "{{authcore_base}}"
          ],
          "path": [
            "api",
            "action"
          ]
        },
        "description": "POST /api/action - kick an online player. Fails with 'User is not online' if the player is offline."
      },
      "response": []
    },
    {
      "name": "Action Logout",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{authcore_token}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"action\": \"logout\",\n  \"uuid\": \"069a79f4-44e9-4726-a5be-fca90e38aaf5\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{authcore_base}}/api/action",
          "host": [
            "{{authcore_base}}"
          ],
          "path": [
            "api",
            "action"
          ]
        },
        "description": "POST /api/action - end the player's active session."
      },
      "response": []
    },
    {
      "name": "Action Unlock",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{authcore_token}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"action\": \"unlock\",\n  \"uuid\": \"069a79f4-44e9-4726-a5be-fca90e38aaf5\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{authcore_base}}/api/action",
          "host": [
            "{{authcore_base}}"
          ],
          "path": [
            "api",
            "action"
          ]
        },
        "description": "POST /api/action - clear the account lock."
      },
      "response": []
    },
    {
      "name": "Action Delete",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{authcore_token}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"action\": \"delete\",\n  \"uuid\": \"069a79f4-44e9-4726-a5be-fca90e38aaf5\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{authcore_base}}/api/action",
          "host": [
            "{{authcore_base}}"
          ],
          "path": [
            "api",
            "action"
          ]
        },
        "description": "POST /api/action - kick the player (if online) and permanently delete the account."
      },
      "response": []
    },
    {
      "name": "Action Set Password",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{authcore_token}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"action\": \"set-password\",\n  \"uuid\": \"069a79f4-44e9-4726-a5be-fca90e38aaf5\",\n  \"value\": \"NewPassw0rd1\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{authcore_base}}/api/action",
          "host": [
            "{{authcore_base}}"
          ],
          "path": [
            "api",
            "action"
          ]
        },
        "description": "POST /api/action - force-reset the player's password. The 'value' field is required."
      },
      "response": []
    },
    {
      "name": "Action Reload",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{authcore_token}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"action\": \"reload\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{authcore_base}}/api/action",
          "host": [
            "{{authcore_base}}"
          ],
          "path": [
            "api",
            "action"
          ]
        },
        "description": "POST /api/action - reload configuration and restart the panel. No uuid required."
      },
      "response": []
    }
  ],
  "variable": [
    {
      "key": "authcore_token",
      "value": "",
      "type": "string",
      "description": "Web panel token from session.web-panel.token in settings.conf. Generate with: openssl rand -hex 16"
    },
    {
      "key": "authcore_base",
      "value": "http://127.0.0.1:25570",
      "type": "string",
      "description": "Web panel base URL (use https://127.0.0.1:25571 when https-enabled is true)"
    }
  ]
}
