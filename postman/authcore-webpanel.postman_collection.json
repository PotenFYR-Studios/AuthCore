{
    "info":  {
                 "name":  "authcore-webpanel",
                 "description":  "AuthCore web panel API requests.\n\nVariables:\n- authcore_base: e.g. http://127.0.0.1:25570\n- authcore_token: full access token (session.web-panel.token in settings.conf)\n- authcore_readonly_token: view-only token (session.web-panel.readonly-token) - actions return 403 with it\n\nRead-only tokens can call GET endpoints (overview, players, history) but POST /api/action returns 403.",
                 "schema":  "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
             },
    "item":  [
                 {
                     "name":  "Overview",
                     "request":  {
                                     "method":  "GET",
                                     "header":  [
                                                    {
                                                        "key":  "Authorization",
                                                        "value":  "Bearer {{authcore_token}}"
                                                    }
                                                ],
                                     "url":  {
                                                 "raw":  "{{authcore_base}}/api/overview",
                                                 "host":  [
                                                              "{{authcore_base}}"
                                                          ],
                                                 "path":  [
                                                              "api",
                                                              "overview"
                                                          ]
                                             },
                                     "description":  "GET /api/overview - server version, registered/online/inLobby/locked/premium counts, TPS, database dialect and Redis status."
                                 },
                     "response":  [

                                  ]
