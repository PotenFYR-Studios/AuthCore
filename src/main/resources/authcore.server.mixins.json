{
  "required": true,
  "package": "net.ded3ec.mixin",
  "compatibilityLevel": "${mixin_compatibility_level}",
  "mixins": [
    "ClientConnectionAccessor",
    "CommandManagerMixin",
    "EntityMixin",
    "InventoryMixin",
    "ItemEntityMixin",
    "MobEntityMixin",
    "ScreenHandlerMixin",
    "ServerHandshakeNetworkHandlerMixin": { "required": false },
    "ServerLoginNetworkHandlerMixin": { "required": false },
    "ServerPlayerInteractionManagerMixin",
    "ServerPlayerMixin",
    "ServerPlayNetworkHandlerChatMixin": { "required": false },
    "ServerPlayNetworkHandlerMixin"
  ],
  "injectors": {
    "defaultRequire": 1
  },
  "overwrites": {
    "requireAnnotations": true
  }
}
